#############################################
# 基本設定（新規の Data Plane RG を作成）
#############################################

# リージョン（例：Japan East）
# location = "japaneast"
location = "eastus"

# Data Plane VNet のアドレス空間（この /16 はモジュール内で /22 に細分化されます）
#   - public: cidrsubnet(var.cidr_dp, 6, 0)  → /22
#   - private: cidrsubnet(var.cidr_dp, 6, 1) → /22
#   - privatelink: cidrsubnet(var.cidr_dp, 6, 2) → /22
cidr_dp = "10.10.0.0/16"

# Data Plane 用 RG は Terraform で新規作成
create_data_plane_resource_group        = true
existing_data_plane_resource_group_name = ""

# （任意）Private サブネットに付与する Service Endpoint（必要なければ空配列のまま）
# 例: ["Microsoft.Storage", "Microsoft.KeyVault"]
private_subnet_endpoints = ["Microsoft.Storage", "Microsoft.KeyVault"]

# 既存の VNet を使用するかどうか
use_existing_vnet                 = false
existing_vnet_name                = ""
existing_vnet_resource_group_name = ""

# Private DNS Zones を作成するかどうか（複数環境で同じ RG を使用する場合 false）
create_private_dns_zones = true

subscription_id = "XXXXXXXXXXXXXXXXXXXXXXXXXXX"

#############################################
# リソース命名
#############################################

# --- リソースグループ ---
data_plane_resource_group_name = "adb-dp-rg"

# --- VNet / NSG ---
vnet_name               = "adb-dp-vnet"
nsg_name                = "adb-dp-nsg"
nsg_rule_aad_name       = "AllowAAD"
nsg_rule_frontdoor_name = "AllowAzureFrontDoor"

# --- サブネット ---
subnet_public_name      = "adb-dp-public"
subnet_private_name     = "adb-dp-private"
subnet_privatelink_name = "adb-dp-privatelink"

# --- Private DNS Zone VNet リンク ---
dns_vnet_link_dpcp_name = "dpcp-vnetlink"
dns_vnet_link_dfs_name  = "dfs-vnetlink"
dns_vnet_link_blob_name = "blob-vnetlink"

# --- 外部ロケーション用リソース ---
ext_loc_identity_name         = "adb-ext-loc-identity"
ext_loc_access_connector_name = "adb-ext-loc-access-connector"
# ストレージアカウント名: 英数字のみ・24文字以内
ext_loc_storage_account_name  = "adbextlocstorage"
ext_storage_container_name    = "external"
# パブリックアクセス無効時のみ PE を作成
ext_storage_public_access_enabled      = false
ext_loc_private_endpoint_dfs_name  = "adb-ext-loc-pe-dfs"
ext_loc_private_endpoint_blob_name = "adb-ext-loc-pe-blob"

# --- DBFS ストレージ ---
# ストレージアカウント名: 英数字のみ・24文字以内
dbfs_storage_account_name = "adbdbfsstorage"

#############################################
# CMK（Customer Managed Key）設定
#############################################

# Key Vault 名: 英数字とハイフン・3〜24文字・グローバル一意
key_vault_name = "adb-cmk-kv"

# Key Vault 内の CMK キー名
cmk_key_name = "databricks-cmk"

# CMK 専用ユーザー割り当てマネージドID 名
cmk_identity_name = "adb-cmk-identity"

# Key Vault プライベートエンドポイント名
key_vault_private_endpoint_name = "adb-cmk-kv-pe"

# privatelink.vaultcore.azure.net DNS Zone の VNet リンク名
dns_vnet_link_kv_name = "kv-vnetlink"

# terraform apply 実行環境のパブリック IP（ローカル PC から apply する場合に設定）
# 確認方法: curl -s https://api.ipify.org
# Azure 内部ネットワーク（VPN・Bastion 等）から実行する場合は空文字のままでよい
# terraform_operator_ip = "203.0.113.45"
