# ==============================================================
# 04_dbx-workspace-settings / terraform.tfvars
# 実行者: データエンジニア
#
# ※ 以下の値は 01/02 の apply 後に取得してください
#   01: cd ../01_azure-infra && terraform output
#   02: cd ../02_databricks-workspace && terraform output
# ==============================================================

# --- 02_databricks-workspace outputs から転記 ---
workspace_url = "https://adb-XXXX.azuredatabricks.net/"
workspace_id  = "XXXXXXXXXXXXXXXX"

# --- 01_azure-infra outputs から転記 ---
resource_group_name            = "adb-dp-tfdemo-xxxxxx-rg"
location                       = "eastus"
ext_loc_storage_account_name  = "tfdemoxxxxxxextloc"
ext_loc_storage_account_id    = "/subscriptions/XXXX/resourceGroups/XXXX/providers/Microsoft.Storage/storageAccounts/XXXX"
ext_loc_container_name        = "external"
ext_loc_abfss_url             = "abfss://external@tfdemoxxxxxxextloc.dfs.core.windows.net/"
ext_loc_managed_identity_id   = "/subscriptions/XXXX/resourceGroups/XXXX/providers/Microsoft.ManagedIdentity/userAssignedIdentities/XXXX"
ext_loc_access_connector_id   = "/subscriptions/XXXX/resourceGroups/XXXX/providers/Microsoft.Databricks/accessConnectors/XXXX"
ext_loc_access_connector_name = "tfdemo-xxxxxx-ext-loc-access-connector"

# --- Databricks アカウント ---
databricks_account_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- 001: グループ ---
uc_group_name       = "uc-users"
ws_admin_group_name = "ws-admins"

# --- 003: サービスプリンシパル ---
service_principal_display_name = "tf-automation-sp"

# --- 005: SQL ウェアハウス ---
sql_warehouse_name = "analytics-warehouse"

# --- 006: IP アクセスリスト ---
ip_access_list = [
  { label = "office-1", address = "8.8.8.8" },
  { label = "office-2", address = "8.8.4.4" }
]

# --- 008: メタストア ---
metastore_name = "my-metastore"

# --- 011: カタログ ---
catalog_name = "analytics_catalog"

# --- 012: スキーマ ---
schema_names = ["bronze", "silver", "gold"]

# --- 013: ボリューム ---
volume_name   = "raw_data"
volume_schema = "bronze"

# --- 015: ネットワークポリシー ---
network_policy_enforcement_mode = "DRY_RUN"

allowed_internet_destinations = []
