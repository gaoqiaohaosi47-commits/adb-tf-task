# ==============================================================
# 02_databricks-workspace / terraform.tfvars
# 実行者: データエンジニア
#
# ※ 以下の値は 01_azure-infra の apply 後に取得してください
#   cd ../01_azure-infra && terraform output
# ==============================================================

# --- 01_azure-infra outputs から転記 ---
prefix                            = "tfdemo-xxxxxx"
dbfs_storage_account_name         = "dbfsxxxxxx"
resource_group_name               = "adb-dp-tfdemo-xxxxxx-rg"
location                          = "eastus"
vnet_id                           = "/subscriptions/XXXX/resourceGroups/XXXX/providers/Microsoft.Network/virtualNetworks/XXXX"
public_subnet_name                = "tfdemo-xxxxxx-dp-public"
private_subnet_name               = "tfdemo-xxxxxx-dp-private"
public_subnet_nsg_association_id  = "/subscriptions/XXXX/.../subnets/tfdemo-xxxxxx-dp-public/providers/Microsoft.Network/networkSecurityGroups/.../associations/..."
private_subnet_nsg_association_id = "/subscriptions/XXXX/.../subnets/tfdemo-xxxxxx-dp-private/providers/Microsoft.Network/networkSecurityGroups/.../associations/..."

# --- ワークスペース設定 ---
public_network_access_enabled = true
subscription_id               = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
