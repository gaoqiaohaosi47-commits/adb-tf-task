# ==============================================================
# 02_databricks-workspace / terraform.tfvars
# 実行者: データエンジニア
#
# ※ 以下の値は 01_azure-infra の apply 後に取得してください
#   cd ../01_azure-infra && terraform output
# ==============================================================

# --- 01_azure-infra outputs から転記 ---
# outputs.dbfs_storage_account_name
dbfs_storage_account_name         = "adbdbfsstorage"
# outputs.resource_group_name
resource_group_name               = "adb-dp-rg"
# outputs.location
location                          = "eastus"
# outputs.vnet_id
vnet_id                           = "/subscriptions/XXXX/resourceGroups/XXXX/providers/Microsoft.Network/virtualNetworks/XXXX"
# outputs.public_subnet_name
public_subnet_name                = "adb-dp-public"
# outputs.private_subnet_name
private_subnet_name               = "adb-dp-private"
# outputs.public_subnet_nsg_association_id
public_subnet_nsg_association_id  = "/subscriptions/XXXX/.../subnets/adb-dp-public/providers/Microsoft.Network/networkSecurityGroups/.../associations/..."
# outputs.private_subnet_nsg_association_id
private_subnet_nsg_association_id = "/subscriptions/XXXX/.../subnets/adb-dp-private/providers/Microsoft.Network/networkSecurityGroups/.../associations/..."

# --- ワークスペース命名 ---
workspace_name              = "adb-dp-workspace"
managed_resource_group_name = "adb-dp-workspace-mrg"

# --- ワークスペース設定 ---
public_network_access_enabled = true
subscription_id               = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
